# Set real values locally or in your hosting platform. Never commit .env.
PORT=5000
CLIENT_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-strong-random-secret-at-least-32-characters
MONGODB_URI=mongodb+srv://username:password@your-cluster.example.mongodb.net/docappointDB
# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
